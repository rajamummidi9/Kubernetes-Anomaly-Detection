# Anomaly Detection Engine
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080

# Kubernetes. Uses the standard kubeconfig (or in-cluster service account when deployed).
KUBECONFIG=
# Default context shown in the UI; any context in the kubeconfig can be picked at runtime.
KUBE_CONTEXT=
# Empty means cluster-wide; otherwise a comma-separated namespace list.
WATCH_NAMESPACES=
EVENT_WINDOW_HOURS=6
# Namespaces excluded from hygiene rules (missing requests, probes, PDBs, ...).
SYSTEM_NAMESPACES=kube-system,kube-public,kube-node-lease,gatekeeper-system,calico-system,tigera-operator,cert-manager,ingress-nginx
NODE_WARN_PERCENT=80
NODE_CRITICAL_PERCENT=90
CACHE_TTL_SECONDS=30

# Optional baseline detector (Prometheus-compatible: Prometheus, Cortex, Mimir, Thanos).
# Leave both empty to disable it; the cluster analysis works without it.
PROMETHEUS_URL=
MIMIR_URL=
METRICS_BACKEND=prometheus
LOKI_URL=
TEMPO_URL=
BASELINE_WINDOW=7d
EVAL_INTERVAL_SECONDS=60
ANOMALY_THRESHOLD=70

# Alerting (optional)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Optional AI intelligence layer. The dashboard never sends raw Secrets or a
# kubeconfig; it sends a bounded, redacted report. AI_MODEL is deliberately not
# hardcoded because model/deployment names differ by account.
# Providers: openai_compatible, azure_openai, anthropic, gemini, ollama
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_API_VERSION=2024-10-21
AI_TIMEOUT_SECONDS=45
AI_MAX_INPUT_CHARS=60000
AI_CACHE_TTL_SECONDS=900
INTELLIGENCE_AUTO_RUN=false
INTELLIGENCE_INTERVAL_SECONDS=300
# Generic JSON webhook. Slack and Teams webhooks above are also supported.
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=warning

# Synthetic baseline metrics for local demos only
DEMO_MODE=false
